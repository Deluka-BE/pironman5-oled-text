    "z": "oled_text_examples",
    "name": "BASE URL en JSON",
    "func": "const base = \"http://local-pironman5-text:34001/api/v1.0/\";\nmsg.url = base + msg.topic;\nmsg.headers = {\"Content-Type\": \"application/json\"};\nreturn msg;",
    "outputs": 1,
